# Database (required). Tables live in auth schema; use search_path=public,auth (public first so migrations can run).
DATABASE_URL=postgres://user:pass@localhost:5432/authrs?options=-c%20search_path%3Dpublic%2Cauth

# Redis (optional; if unset or REDIS_ENABLED=false, sessions/rate-limit use DB or in-memory fallback)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging
RUST_LOG=info

# KV store: encryption key for sensitive values (base64 or raw). Required if storing sensitive kv_store entries.
# KV_STORE_ENCRYPTION_KEY=

# Platform (builder) access control (required). Restricts the /admin/tenants (platform) routes.
# BUILDER_TENANT_ID: the tenant whose users may access platform routes.
# ALLOWED_ROLES: comma-separated roles permitted on platform routes (must be non-empty).
BUILDER_TENANT_ID=builder
ALLOWED_ROLES=builder_developer_admin,builder_implementor_admin,developer,implementor,architect

# SMTP for email OTP (optional; if set, POST /login/email-otp/request sends codes via email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Frontend base URL: GLOBAL fallback for building links (e.g. password-reset emails
# become {FRONTEND_URL}/reset-password?token=XXX). A per-tenant value in kv_store
# (group "frontend_config", key "base_url") takes precedence. If neither is set, the
# reset email falls back to sending the raw token instead of a link. No trailing slash.
# FRONTEND_URL=https://app.example.com

# Seed (optional): run with `cargo run --bin seed`. Base data is created from these env vars.
# SEED_TENANT_ID=acme_corp
# SEED_TENANT_NAME=Acme Corp
# SEED_ROLE_NAME=Launchpad Admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=changeme
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=User
# Per-tenant frontend base URL -> stored in kv_store (frontend_config.base_url), used
# for this tenant's reset links and overriding the global FRONTEND_URL above.
# SEED_APP_URL=https://acme.example.com
