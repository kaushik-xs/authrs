    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"retypePassword\": \"{{retypePassword}}\"\n}"
            },
            "url": "{{baseUrl}}/signup"
          }
        },
        {
          "name": "Login (email + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.sessionToken) {",
                  "    pm.collectionVariables.set('sessionToken', json.sessionToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/login/email-password"
          }
        },
        {
          "name": "Login (email OTP request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/login/email-otp/request"
          }
        },
        {
          "name": "Login (OTP verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.sessionToken) {",
                  "    pm.collectionVariables.set('sessionToken', json.sessionToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{otpIdentifier}}\",\n  \"code\": \"{{otpCode}}\",\n  \"channel\": \"{{otpChannel}}\"\n}"
            },
            "url": "{{baseUrl}}/login/otp/verify"
          }
        },
        {
          "name": "Login (username + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.sessionToken) {",
                  "    pm.collectionVariables.set('sessionToken', json.sessionToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/login/username-password"
          }
        },
        {
          "name": "Login (mobile OTP request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"\",\n  \"countryCode\": \"\"\n}"
            },
            "url": "{{baseUrl}}/login/mobile-otp/request"
          }
        },
        {
          "name": "Login (WhatsApp OTP request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"\",\n  \"countryCode\": \"\"\n}"
            },
            "url": "{{baseUrl}}/login/mobile-whatsapp-otp/request"
          }
        },
        {
          "name": "OAuth redirect",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/oauth/{{provider}}"
          }
        },
        {
          "name": "OAuth callback",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/{{provider}}/callback",
              "host": ["{{baseUrl}}"],
              "path": ["oauth", "{{provider}}", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "",
                  "description": "Authorization code returned by the OAuth provider"
                },
                {
                  "key": "state",
                  "value": "",
                  "description": "State parameter for CSRF protection"
                }
              ]
            },
            "description": "OAuth provider callback — receives the authorization code and state from the provider and completes the OAuth flow."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"retypePassword\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/reset-password"
          }
        }
      ]
    },
    {
      "name": "MFA",
      "item": [
        {
          "name": "Enable MFA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/mfa/enable"
          }
        },
        {
          "name": "Verify MFA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"\"\n}"
            },
            "url": "{{baseUrl}}/mfa/verify"
          }
        },
        {
          "name": "Validate MFA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"\"\n}"
            },
            "url": "{{baseUrl}}/mfa/validate"
          }
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Validate session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/session/validate"
          }
        },
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/session/me"
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"retypePassword\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/session/change-password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/session/logout"
          }
        },
        {
          "name": "Logout all sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/session/logout/all"
          }
        },
        {
          "name": "Force change password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.sessionToken) {",
                  "    pm.collectionVariables.set('sessionToken', json.sessionToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changeToken\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"retypePassword\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/session/force-change-password",
            "description": "Complete a forced password change using the changeToken returned by login when passwordChangeRequired is true. Returns a new session token on success."
          }
        }
      ]
    },
    {
      "name": "Admin — Users",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) {",
                  "    pm.collectionVariables.set('userId', json.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{email}}\",\n  \"username\": \"\",\n  \"mobile\": \"\",\n  \"countryCode\": \"\",\n  \"password\": \"{{password}}\",\n  \"retypePassword\": \"{{retypePassword}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/users",
            "description": "Create a user. Requires at least one of: email, (mobile + countryCode), or username. Optional: firstName, lastName, password + retypePassword."
          }
        },
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.users && json.users.length > 0 && json.users[0].id) {",
                  "    pm.collectionVariables.set('userId', json.users[0].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                {
                  "key": "includeArchived",
                  "value": "true",
                  "disabled": true,
                  "description": "Set to true to include archived users in the response"
                }
              ]
            },
            "description": "List all users for the tenant. Sets userId from first user. Add ?includeArchived=true to include archived users."
          }
        },
        {
          "name": "Archive user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/archive",
            "description": "Soft-delete a user by setting their status to 'archived'. Archived users cannot log in and are excluded from List users by default."
          }
        },
        {
          "name": "Reset user password (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"{{newPassword}}\",\n  \"retypePassword\": \"{{newPassword}}\",\n  \"forcePasswordChange\": false\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}/reset-password"
          }
        },
        {
          "name": "Set access validity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessValidUntil\": \"2026-12-31T23:59:59Z\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}/access-validity",
            "description": "Set or clear the access expiry for a user. Once the datetime passes, the user cannot log in and receives a 403 access_expired error. Send null to remove the expiry (access becomes indefinite)."
          }
        },
        {
          "name": "Clear access validity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessValidUntil\": null\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}/access-validity",
            "description": "Remove the access expiry from a user so their access is indefinite."
          }
        },
        {
          "name": "List user roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/roles",
            "description": "Returns roles assigned to the user. Each role includes id, name, and uid."
          }
        },
        {
          "name": "Assign role to user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": \"{{roleId}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}/roles"
          }
        },
        {
          "name": "Remove role from user",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/roles/{{roleId}}"
          }
        }
      ]
    },
    {
      "name": "Admin — Roles",
      "item": [
        {
          "name": "Create role",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) {",
                  "    pm.collectionVariables.set('roleId', json.id);",
                  "  }",
                  "  if (json.uid) {",
                  "    pm.collectionVariables.set('roleUid', json.uid);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{roleName}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/roles",
            "description": "Create a role. A stable uid is auto-generated from the name (snake_case, write-once). Response includes id, name, and uid. Sets roleId and roleUid variables."
          }
        },
        {
          "name": "List roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.roles && json.roles.length > 0) {",
                  "    if (json.roles[0].id) {",
                  "      pm.collectionVariables.set('roleId', json.roles[0].id);",
                  "    }",
                  "    if (json.roles[0].uid) {",
                  "      pm.collectionVariables.set('roleUid', json.roles[0].uid);",
                  "    }",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/roles",
            "description": "List all roles for the tenant. Each role includes id, name, and uid. Sets roleId and roleUid from first role."
          }
        },
        {
          "name": "Attach permission to role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissionId\": \"{{permissionId}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/roles/{{roleId}}/permissions",
            "description": "Attach a permission (Cedar policy) to a role. The policy takes effect on the next request (cache evicted)."
          }
        },
        {
          "name": "List role permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/roles/{{roleId}}/permissions",
            "description": "List all permissions attached to a role. Returns id, name, and document for each."
          }
        },
        {
          "name": "Detach permission from role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/roles/{{roleId}}/permissions/{{permissionId}}"
          }
        }
      ]
    },
    {
      "name": "Admin — Permissions",
      "item": [
        {
          "name": "Create permission",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) {",
                  "    pm.collectionVariables.set('permissionId', json.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"allow-editor-read-materials\",\n  \"description\": \"Allow editors to read materials\",\n  \"document\": {\n    \"version\": \"1.0\",\n    \"statements\": [\n      {\n        \"sid\": \"AllowEditorReadMaterials\",\n        \"effect\": \"Allow\",\n        \"principals\": [\"role:{{roleUid}}\"],\n        \"actions\": [\"getMaterials\"],\n        \"resources\": [\"service:core/package:manufacturing_core/table:materials\"],\n        \"conditions\": []\n      }\n    ]\n  }\n}"
            },
            "url": "{{baseUrl}}/admin/permissions",
            "description": "Create a Cedar permission policy. Principals accept role:<uid>, role:<name>, user:<uuid>, user:<email>, user:<username>, or *. The document is validated before saving. Sets permissionId variable."
          }
        },
        {
          "name": "List permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/permissions",
            "description": "List all permissions for the tenant. Returns id, name, description, and document for each."
          }
        },
        {
          "name": "Get permission",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/permissions/{{permissionId}}"
          }
        },
        {
          "name": "Delete permission",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/permissions/{{permissionId}}",
            "description": "Delete a permission. Also evicts the tenant's PolicySet cache."
          }
        },
        {
          "name": "Check permission (single action)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"resource\": \"service:core/package:manufacturing_core/table:materials\",\n  \"action\": \"getMaterials\",\n  \"context\": {}\n}"
            },
            "url": "{{baseUrl}}/admin/permissions/check",
            "description": "Evaluate Cedar policy for a specific user, resource, and action. Returns { resource, action, allowed: true|false }."
          }
        },
        {
          "name": "Check permission (all actions for table)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"resource\": \"service:core/package:manufacturing_core/table:materials\",\n  \"context\": {}\n}"
            },
            "url": "{{baseUrl}}/admin/permissions/check",
            "description": "Omit action to evaluate all actions for the resource scope. Returns { resource, decisions: { actionName: true|false, ... } }."
          }
        },
        {
          "name": "Check permission (all actions for package)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"resource\": \"service:core/package:manufacturing_core\",\n  \"context\": {}\n}"
            },
            "url": "{{baseUrl}}/admin/permissions/check",
            "description": "Check all actions across every table in a package."
          }
        },
        {
          "name": "Check permission (all actions for service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"resource\": \"service:core\",\n  \"context\": {}\n}"
            },
            "url": "{{baseUrl}}/admin/permissions/check",
            "description": "Check all actions across all packages and tables in the service."
          }
        }
      ]
    },
    {
      "name": "Admin — Packages",
      "item": [
        {
          "name": "Sync package",
          "request": {
