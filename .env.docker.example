# Docker Compose: copy to .env. App uses host Postgres (no db container).

# Required: host Postgres. Use host.docker.internal (Mac/Windows; on Linux enable extra_hosts in compose).
DATABASE_URL=postgres://user:pass@host.docker.internal:5432/authrs?options=-c%20search_path%3Dpublic%2Cauth

# App
SERVER_PORT=3000
RUST_LOG=info
REDIS_ENABLED=true
REDIS_PORT=6379

# Optional
# KV_STORE_ENCRYPTION_KEY=

# SMTP for email OTP (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Frontend base URL: GLOBAL fallback for building links (e.g. password-reset emails
# become {FRONTEND_URL}/reset-password?token=XXX). A per-tenant value in kv_store
# (group "frontend_config", key "base_url") takes precedence. If neither is set, the
# reset email falls back to sending the raw token instead of a link. No trailing slash.
# FRONTEND_URL=https://app.example.com
